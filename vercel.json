{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/fumo-showcase/browser",
  "functions": {
    "api/index.ts": {
      "includeFiles": "knowledge/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.+)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|Zalo|zalo|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare|KAKAOTALK).*"
        }
      ],
      "destination": "/api?__path=og&p=/$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}