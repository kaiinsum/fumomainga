{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/fumo-showcase/browser",
  "functions": {
    "api/index.ts": {
      "includeFiles": "knowledge/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.+)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__path=sitemap"
    },
    {
      "source": "/site-icon",
      "destination": "/api?__path=site-icon"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?__path=sitemap&kind=robots"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|Storebot-Google|bingbot|BingPreview|coccocbot|DuckDuckBot|YandexBot|Applebot|Baiduspider).*"
        }
      ],
      "destination": "/api?__path=og&mode=search&p=/$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|Slackbot|Discordbot|TelegramBot|WhatsApp|LinkedInBot|Zalo|zalo|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare|KAKAOTALK).*"
        }
      ],
      "destination": "/api?__path=og&p=/$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(img|bg|og|sfx|season|fumo-ninja|jp-type|touhoudle)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fumomainga.vercel.app"
        }
      ],
      "destination": "https://www.fumomainga.io.vn/:path*",
      "permanent": true
    }
  ]
}
